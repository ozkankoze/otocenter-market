{
  "name": "@ocm/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:status": "tsx scripts/migrate.ts status",
    "reset": "tsx scripts/migrate.ts reset",
    "seed": "tsx scripts/seed.ts && tsx scripts/vehicle-tree-sync.ts && tsx scripts/urun-yukle.ts",
    "seed:demo-only": "tsx scripts/seed.ts",
    "doctor": "tsx scripts/db-doctor.ts",
    "vehicle-tree": "tsx scripts/vehicle-tree-sync.ts",
    "vehicle-tree:export": "tsx scripts/vehicle-tree-export.ts",
    "reindex": "tsx scripts/reindex.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/benchmark.ts",
    "urun-import-uret": "tsx scripts/urun-import-uret.ts",
    "urun-import-onizle": "tsx scripts/urun-import-onizle.ts",
    "urun-import-onayla": "tsx scripts/urun-import-onayla.ts",
    "urun-gorsel-cikar": "tsx scripts/urun-gorsel-cikar.ts",
    "urun-gorsel-bagla": "tsx scripts/urun-gorsel-bagla.ts",
    "urun-yukle": "tsx scripts/urun-yukle.ts",
    "urun-gorsel-yertutucu": "tsx scripts/urun-gorsel-yertutucu.ts"
  },
  "dependencies": {
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
