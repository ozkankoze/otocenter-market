# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# ── Veritabanı ───────────────────────────────────────────────────────────────
# Yerelde:
DATABASE_URL="postgresql://KULLANICI:PAROLA@127.0.0.1:5432/otocenter?schema=public"
#
# Canlıda (Vercel) İKİ AYRI ADRES kullanılır:
#   • Siteye  → HAVUZLANMIŞ (pooled) adres, içinde "-pooler" geçer
#   • Migrasyon ve seed'e → DOĞRUDAN (direct) adres
# Sunucusuz ortamda her istek yeni bağlantı açtığı için havuzlanmış adres şart.
# DATABASE_URL="postgresql://...@ep-xxx-pooler.eu-central-1.aws.neon.tech/otocenter?sslmode=require"

# Sunucusuz ortamda düşük tutun (kod varsayılanı 10, Vercel için 3 önerilir).
# DB_POOL_MAX="3"

# ── Bağlantı zaman sınırları (hepsi isteğe bağlı) ────────────────────────────
# Hiçbir sorgu SÜRESİZ beklemesin diye her bağlantıda otomatik ayarlanır.
#   PG_LOCK_TIMEOUT       kilit bekleme sınırı        (öntanımlı 15s)
#   PG_STATEMENT_TIMEOUT  tek sorgu sınırı            (öntanımlı 900s)
#   DB_CONNECT_TIMEOUT    bağlantı kurma sınırı, ms   (öntanımlı 15000)
# PG_LOCK_TIMEOUT="15s"
# PG_STATEMENT_TIMEOUT="900s"
# DB_CONNECT_TIMEOUT="15000"
#
# Sertifika doğrulaması ortam kaynaklı bir sebeple başarısız olursa
# (kurumsal ağ, araya giren güvenlik duvarı) şifrelemeyi koruyup doğrulamayı
# kapatır. Sorunun sertifika mı ağ mı olduğunu `npm run db:doctor` söyler.
# PGSSLMODE="no-verify"

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Oto Center Market"

# ── Yönetim paneli ───────────────────────────────────────────────────────────
# ⚠ CANLIDA ZORUNLU. Tanımlı değilse (ya da kısaysa) panel KAPALI kalır —
# panel müşteri adı, adresi ve telefonunu gösterdiği için varsayılan parola yok.
#     ADMIN_PASSWORD       → en az 10 karakter
#     ADMIN_SESSION_SECRET → en az 32 karakter, rastgele
# Rastgele değer için:  openssl rand -base64 32
# Yerel geliştirmede (NODE_ENV≠production) tanımsızsa eski varsayılanlar çalışır.
# ADMIN_PASSWORD=""
# ADMIN_SESSION_SECRET=""

# ── Ödeme: PayTR iFrame API ──────────────────────────────────────────────────
# PayTR mağaza paneli → Bilgi sayfasından alınır. KEY ve SALT GİZLİDİR; repoya,
# sohbete, e-postaya yazılmaz — yalnızca Vercel ortam değişkenine girilir.
# Üçünden biri eksikse ödeme sayfası "geçici olarak kapalı" der.
# PAYTR_MERCHANT_ID=""
# PAYTR_MERCHANT_KEY=""
# PAYTR_MERCHANT_SALT=""
#
# "0" → CANLI (gerçek kart çekimi). Tanımsız ya da başka bir değer → TEST modu.
# PAYTR_TEST_MODE="1"
#
# PayTR panelinde "Bildirim URL" olarak şu adres tanımlanmalı:
#   https://otocentermarket.com/api/odeme/paytr-bildirim

# Faz 3+ için ayrılmıştır — Sprint 1'de kullanılmaz
# REDIS_URL=
# S3_ENDPOINT=
# S3_BUCKET=
