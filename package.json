{
  "name": "otocenter-market",
  "version": "0.1.0",
  "private": true,
  "description": "Oto Center Market — otomotiv filtre, yağ ve bakım ürünleri e-ticaret platformu",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ocm/web",
    "build": "npm run build --workspace=@ocm/web",
    "start": "npm run start --workspace=@ocm/web",
    "lint": "npm run lint --workspace=@ocm/web",
    "typecheck": "npm run typecheck --workspace=@ocm/web && npm run typecheck --workspace=@ocm/db",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "db:migrate": "npm run migrate --workspace=@ocm/db",
    "db:seed": "npm run seed --workspace=@ocm/db",
    "db:reset": "npm run reset --workspace=@ocm/db",
    "db:migrate:status": "npm run migrate:status --workspace=@ocm/db",
    "db:reindex": "npm run reindex --workspace=@ocm/db",
    "db:doctor": "npm run doctor --workspace=@ocm/db",
    "db:vehicle-tree": "npm run vehicle-tree --workspace=@ocm/db",
    "db:vehicle-tree:export": "npm run vehicle-tree:export --workspace=@ocm/db",
    "test": "npm run test --workspace=@ocm/db",
    "db:urun-import-uret": "npm run urun-import-uret --workspace=@ocm/db",
    "db:urun-import-onizle": "npm run urun-import-onizle --workspace=@ocm/db --",
    "db:urun-import-onayla": "npm run urun-import-onayla --workspace=@ocm/db --",
    "db:urun-import-geri-al": "npm run urun-import-geri-al --workspace=@ocm/db --",
    "db:urun-gorsel-cikar": "npm run urun-gorsel-cikar --workspace=@ocm/db",
    "db:urun-gorsel-bagla": "npm run urun-gorsel-bagla --workspace=@ocm/db",
    "db:urun-yukle": "npm run urun-yukle --workspace=@ocm/db",
    "db:urun-gorsel-yertutucu": "npm run urun-gorsel-yertutucu --workspace=@ocm/db"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
